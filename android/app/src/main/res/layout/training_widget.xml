<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background" android:contentDescription="Push Pal — otwórz trening lub plan">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PUSH" android:textColor="#64DD95" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="40" android:textColor="#FFFFFF" android:textSize="44sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#AFBCB3" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_trend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#AFBCB3" android:textSize="11sp" android:maxLines="2"/>
    <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp" android:gravity="center" android:background="@drawable/widget_button" android:text="Start" android:textColor="#06150C" android:textStyle="bold" android:textSize="13sp"/>
</LinearLayout>
